# Lockdep profile: verifier and BPF runtime locking bugs (deadlocks, sleeping
# in atomic context, lock ordering) are detected and reported. Boot with
# --append "panic_on_warn=1" to turn the reports into a panic.
CONFIG_PROVE_LOCKING=y
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_FRAME_WARN=0
